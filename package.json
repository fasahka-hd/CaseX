  "private": true,
  "description": "Real Steam-backed CS2 upgrade site: Steam OpenID, live inventory, persistent balance and live drops.",
  "main": "server.js",
  "scripts": {
    "start": "node -r ./scripts/steam-market-queue scripts/launch.js",

{
  "name": "keyser-upgrade",
  "version": "2.0.0",
  "private": true,
  "description": "Real Steam-backed CS2 upgrade site: Steam OpenID, live inventory, persistent balance and live drops.",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "start:sqlite": "node scripts/launch.js --sqlite",
    "start:prod": "node scripts/launch.js --no-dev",
    "server": "node server.js",
    "migrate:sqlite-to-pg": "node scripts/migrate-to-postgres.js",
    "infra:up": "node scripts/infra.js up",
    "infra:down": "node scripts/infra.js down",
    "infra:status": "node scripts/infra.js status"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0"
  }
}

# Файл для docker compose (положите рядом как .env)
PGUSER=upgrader
# Обязательно задайте собственный пароль:
PGPASSWORD=
PGDATABASE=upgrader
# Обязательный секрет приложения:
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=https://your-domain.example
ADMIN_STEAMIDS=
SUPPORT_STEAMIDS=
STEAM_API_KEY=
PAYMENTS_MODE=disabled

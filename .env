# Production URL, without trailing slash
BASE_URL=localhost

# Session secret: generate a long random value
SESSION_SECRET=change-me-to-a-long-random-secret

# Steam Web API key is only needed for optional profile data.
# Steam OpenID login itself uses Steam's official OpenID provider.
STEAM_API_KEY=712BD6AAC1CECDA9315264D607CC3E3F

# Display name. Change this one value if the final brand name differs.
BRAND_NAME=НАЗВАНИЕ

# Optional Telegram/support destinations
TELEGRAM_URL=https://t.me/
SUPPORT_ENABLED=true
PORT=3000

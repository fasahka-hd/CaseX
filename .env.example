# Скопируйте в .env и заполните нужные значения
PORT=3000
BASE_URL=http://localhost:3000
# APP_BASE_PATH=

# Обязательный секрет: соль сессий и подписей. В production — обязателен.
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Steam
STEAM_API_KEY=
# Через запятую, SteamID64 владельцев (нельзя понизить/забанить из админки)
ADMIN_STEAMIDS=
# Через запятую, SteamID64 сотрудников поддержки
SUPPORT_STEAMIDS=

# PostgreSQL (используется только при явно заданном пароле)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=upgrader
# PGPASSWORD=
# PGDATABASE=upgrader

# Redis (кеш и rate-limit)
# REDIS_ENABLED=1
# REDIS_URL=redis://127.0.0.1:6379

# SMTP рассылки
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com

# Прокси для Steam Market (каждый с новой строки или через запятую)
# PROXY_LIST=

# Режим платежей: disabled | simulation
PAYMENTS_MODE=simulation
